{
  "name": "code-impact",
  "displayName": "Code Impact",
  "description": "Lightweight change-impact helper for VS Code",
  "version": "0.0.1",
  "publisher": "landotakman1",
  "repository": {
    "type": "git",
    "url": "https://github.com/landotakman1/code-impact.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-impact",
          "title": "Impact",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "code-impact": [
        {
          "id": "impactView",
          "name": "Change Impact",
          "icon": "$(list-tree)"
        }
      ]
    },
    "commands": [
      {
        "command": "code-impact.showImpact",
        "title": "Show Impact"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "code-impact.showImpact",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Code Impact",
      "properties": {
        "codeImpact.maxResults": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of results to show"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  }
}
